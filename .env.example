# OpenCode AI Coordinator Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="OpenCode AI Coordinator"
APP_VERSION="1.0.0"
APP_DESCRIPTION="A production-ready webapp that coordinates AI providers for code tasks"
ENVIRONMENT="development"  # development, staging, production

# ============================================================================
# Server Settings
# ============================================================================
SERVER_HOST="0.0.0.0"      # Bind to all interfaces
SERVER_PORT=8000           # Port to listen on
SERVER_DEBUG=false        # Disable debug in production
SERVER_WORKERS=4          # Number of worker processes
SERVER_RELOAD=false       # Disable auto-reload in production

# ============================================================================
# Security Settings
# ============================================================================
SECURITY_API_KEY_REQUIRED=true
# Add your API keys (comma-separated)
SECURITY_API_KEYS="your-api-key-1,your-api-key-2"

# CORS Settings
SECURITY_CORS_ORIGINS="*"
SECURITY_CORS_ALLOW_CREDENTIALS=true
SECURITY_CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,OPTIONS"
SECURITY_CORS_ALLOW_HEADERS="*"

# ============================================================================
# Database Settings (SQLite by default)
# ============================================================================
DATABASE_URL="sqlite:///./open_coordinator.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/open_coordinator"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# Redis Settings
# ============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600
REDIS_QUEUE_NAME="open_coordinator_tasks"

# ============================================================================
# Rate Limit Settings
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_REQUESTS_PER_HOUR=10000
RATE_LIMIT_BURST_SIZE=100

# ============================================================================
# Logging Settings
# ============================================================================
LOGGING_LEVEL="INFO"
LOGGING_LOG_FILE="open_coordinator.log"
LOGGING_ENABLE_CONSOLE=true

# ============================================================================
# Template Settings
# ============================================================================
TEMPLATES_TEMPLATE_DIR="./templates"
TEMPLATES_AUTO_RELOAD=true

# ============================================================================
# Code Settings
# ============================================================================
CODE_DEFAULT_LANGUAGE="python"
CODE_DEFAULT_TIMEOUT=300
CODE_MAX_TOKENS=32768
CODE_DEFAULT_TEMPERATURE=0.7

# ============================================================================
# AI Provider Settings
# ============================================================================

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_RATE_LIMIT=100
OPENAI_TIMEOUT=120
OPENAI_ENABLED=true
OPENAI_PRIORITY=1

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_RATE_LIMIT=100
ANTHROPIC_TIMEOUT=120
ANTHROPIC_ENABLED=true
ANTHROPIC_PRIORITY=2

# Mistral
MISTRAL_API_KEY="..."
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_RATE_LIMIT=100
MISTRAL_TIMEOUT=120
MISTRAL_ENABLED=true
MISTRAL_PRIORITY=3

# Google (Gemini)
GOOGLE_API_KEY="..."
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GOOGLE_RATE_LIMIT=100
GOOGLE_TIMEOUT=120
GOOGLE_ENABLED=false
GOOGLE_PRIORITY=4

# Cohere
COHERE_API_KEY="..."
COHERE_BASE_URL="https://api.cohere.ai/v1"
COHERE_RATE_LIMIT=100
COHERE_TIMEOUT=120
COHERE_ENABLED=false
COHERE_PRIORITY=5

# Groq
GROQ_API_KEY="..."
GROQ_BASE_URL="https://api.groq.com/v1"
GROQ_RATE_LIMIT=100
GROQ_TIMEOUT=120
GROQ_ENABLED=false
GROQ_PRIORITY=6

# Local (Ollama, etc.)
LOCAL_API_KEY=""
LOCAL_BASE_URL="http://localhost:11434/v1"
LOCAL_RATE_LIMIT=100
LOCAL_TIMEOUT=120
LOCAL_ENABLED=false
LOCAL_PRIORITY=7

# ============================================================================
# FREE CLOUD AI PROVIDERS
# ============================================================================

# HuggingFace Inference API (FREE)
# Get API key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_..."
HUGGINGFACE_BASE_URL="https://api-inference.huggingface.co"
HUGGINGFACE_RATE_LIMIT=100
HUGGINGFACE_TIMEOUT=120
HUGGINGFACE_ENABLED=true
HUGGINGFACE_PRIORITY=2

# Together AI (FREE - $25/month credit)
